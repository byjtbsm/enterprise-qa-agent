# Mock mode requires no configuration.
# Live mode loads this project's .env automatically. Existing environment variables take precedence.
# Recommended setup: python scripts/configure.py (interactive; API key is hidden).
MODEL_API_KEY=replace_with_your_key
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=replace_with_your_available_json_mode_model
MODEL_TIMEOUT=45
# For DeepSeek: MODEL_BASE_URL=https://api.deepseek.com ; use a current model name from your account.
